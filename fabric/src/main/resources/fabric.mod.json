{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://panda-s-workshop.github.io/teeming/",
    "sources": "https://github.com/Panda-s-Workshop/teeming",
    "issues": "https://github.com/Panda-s-Workshop/teeming/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.panda.teeming.fabric.TeemingFabric"
    ],
    "client": [
      "com.panda.teeming.fabric.client.TeemingFabricClient"
    ]
  },
  "accessWidener": "teeming.accesswidener",
  "mixins": [
    "teeming.mixins.json",
    "teeming-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_min}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
